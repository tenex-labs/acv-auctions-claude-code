{
  "name": "inspection-desk",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Inspection Desk two-task workshop",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "preflight": "node scripts/preflight.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-size.mjs",
    "test:unit": "vitest run tests/unit",
    "test:participant": "vitest run tests/participant",
    "reset:data": "node scripts/reset-data.mjs",
    "package": "node scripts/package.mjs",
    "hook:probe": "node scripts/hook-probe.mjs",
    "check:foundation": "node scripts/check.mjs check:foundation",
    "check:increment": "node scripts/check.mjs check:increment",
    "check:task1": "node scripts/check.mjs check:task1",
    "check:task2": "node scripts/check.mjs check:task2",
    "check": "node scripts/check.mjs check",
    "test": "node scripts/check.mjs test",
    "test:e2e": "node scripts/check.mjs test:e2e"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "fflate": "0.8.2"
  }
}
